{
  "name": "futbol-familia-gg",
  "private": true,
  "version": "0.1.0",
  "description": "Futbol Familia GG. Futbol arcade de pixel art con Sophie, Alana, Papa, Mama y Thor.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173 --strictPort",
    "test": "vitest run",
    "sim:long": "SIM_LONG=1 vitest run",
    "e2e": "node tests/e2e/run.mjs",
    "assets": "python3 tools/check_sheets.py",
    "fonts": "node tools/copy_fonts.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@fontsource/pixelify-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
